# Внутренняя LLM (OpenAI-совместимый API). По умолчанию выключена — работают только правила.
# Чтобы включить, раскомментируйте и укажите свои значения:
# LLM_BASE_URL=http://llm.internal:8000/v1
# LLM_API_KEY=none
# LLM_MODEL=имя-модели
# LLM_TIMEOUT=180

# Путь к tesseract, если его нет в PATH (обычно нужно только на Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Сколько документов обрабатывать одновременно (остальные ждут в очереди).
# OCR нагружает CPU: 1 воркер на каждые 2–4 ядра.
WORKERS=1

MAX_UPLOAD_MB=60
# Через сколько минут удалять из памяти незабранный результат
RESULT_TTL_MIN=30

# Разрешение: для распознавания и для итогового PDF
OCR_DPI=300
OUTPUT_DPI=200
JPEG_QUALITY=80

# Каталог задач (переживают перезапуск службы). На сервере задаётся в redactor.service: /run/redactor
# STATE_DIR=./data
# Сколько раз пробовать документ, если процесс падал во время его обработки
MAX_ATTEMPTS=3
