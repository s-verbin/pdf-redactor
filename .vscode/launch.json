{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Сервис (http://localhost:8088)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8088"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Проверка окружения",
      "type": "debugpy",
      "request": "launch",
      "module": "app.check",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Обработать PDF без веб-интерфейса",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": ["${input:pdfPath}", "--debug", "debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "pdfPath",
      "type": "promptString",
      "description": "Путь к PDF-файлу"
    }
  ]
}
